# --- server ---
PORT=8765
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=false

# --- Sarvam Document Intelligence ---
SARVAM_API_KEY=

# --- n8n (backend -> n8n is localhost; n8n -> backend is host.docker.internal:8765) ---
# Test URL while the workflow is open in the editor, production URL once activated.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/karyakarta-documents
# If n8n is unreachable, run the pipeline in-process instead
N8N_FALLBACK_INPROCESS=true

# --- Cognee memory layer: cloud | local ---
COGNEE_MODE=cloud
COGNEE_BASE_URL=https://tenant-cefd6bcc-9c56-4a68-af77-5c6e6355d790.aws.cognee.ai
COGNEE_TENANT_ID=cefd6bcc-9c56-4a68-af77-5c6e6355d790
COGNEE_USER_ID=3bdcaba2-bb0b-4fa2-8719-a212610d3f7c
COGNEE_API_KEY=
COGNEE_TIMEOUT_SECONDS=60

# false = uploads only store files; pipeline must be triggered manually
PIPELINE_AUTORUN=true

# Voice Chase: Sarvam Samvaad agent (console -> your agent -> app id). Key falls back to SARVAM_API_KEY.
SARVAM_AGENT_ID=
SARVAM_API_KEY_NEW_FOR_VOICE=
# (SARVAM_AGENT_API_KEY is also accepted; both fall back to SARVAM_API_KEY)
SARVAM_ORG_ID=019f298f-eba1-725a-a645-5db63306d773
SARVAM_WORKSPACE_ID=019f298f-eba7-7b7a-8f83-a767c766c059
# n8n workflow that places the call (leave empty until phone calling is set up)
N8N_SETTLEMENT_WEBHOOK_URL=
FINOPS_SEED_DEMO=true
N8N_VOICE_WEBHOOK_URL=

# Outbound voice calls: Sarvam Instant Outbound over a connected Twilio number. The result is polled; no public URL needed.
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_AGENT_VERSION=1
# Optional: a publicly reachable URL for Sarvam's call-completed webhook (then polling is skipped)
SARVAM_CALLBACK_URL=

# Drishti: contact point verification. The capture link a merchant opens must be on https for a phone's camera and GPS (use a tunnel such as ngrok / cloudflared).
PUBLIC_APP_URL=http://localhost:5173
N8N_CPV_WEBHOOK_URL=http://localhost:5678/webhook/karyakarta-cpv-start
CPV_RADIUS_M=100
CPV_MAX_ACCURACY_M=100
CPV_LINK_HOURS=24
# DEMO ONLY: lets the Drishti card set where the shop "is" (labelled on the case). Leave false in anything real.
CPV_ALLOW_DEMO_REFERENCE=false

# V-CIP pre-interview: a SECOND Sarvam agent (see voice/SARVAM_VCIP_AGENT_SETUP.md)
SARVAM_VCIP_AGENT_ID=
SARVAM_VCIP_AGENT_VERSION=
